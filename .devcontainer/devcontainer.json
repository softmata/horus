{
  "name": "HORUS",

  // Builds the repository Dockerfile's `devcontainer` stage, which is the `dev`
  // stage plus rustfmt/clippy and without `ENTRYPOINT ["horus"]`.
  //
  // This used to say `"target": "builder"`, which skipped the `dev` stage
  // entirely — no python3, no cmake, no g++, no clang-format — and made up the
  // difference by re-installing a *different* package list from
  // postCreateCommand with `sudo apt-get`. rust:1.90-slim-bookworm ships no
  // sudo and remoteUser here is root, so that command failed and the container
  // came up with none of it. Nothing built this file, so nothing noticed.
  // .github/workflows/container-images.yml now does.
  "build": {
    "dockerfile": "../Dockerfile",
    "target": "devcontainer"
  },

  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },

  // No postCreateCommand: every package this container needs is installed by
  // the Dockerfile stage above, so there is one dependency list rather than two
  // that can disagree.

  // HORUS nodes talk over shared memory. The default 64 MB /dev/shm is too
  // small for image or point-cloud topics, and --ipc=host lets nodes in the
  // container reach nodes on the host.
  "runArgs": ["--shm-size=1g", "--ipc=host"],

  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "ms-python.python"
      ],
      "settings": {
        "rust-analyzer.check.command": "clippy",

        // Keep rust-analyzer's `cargo check` out of the shared target/ dir so
        // flycheck and manual `cargo build` stop blocking each other on the
        // cargo package-cache lock.
        "rust-analyzer.cargo.targetDir": true,

        // `net` is the only non-default feature on the `horus` facade crate.
        // Without it the entire `pub mod net` block in horus/src/lib.rs is
        // cfg'd out and gets no hover, goto or completion. horus_net is a path
        // dependency, so this adds no download and no native build.
        //
        // Do NOT widen this to "all": --all-features pulls in iceoryx2 and
        // zstd, which need a network fetch plus libclang and a native C build
        // on every reload, for ~0.4% more analysed code.
        "rust-analyzer.cargo.features": ["horus/net"]
      }
    }
  },

  // The image runs as root (rust:1.90-slim-bookworm has no other user and no
  // sudo). Anything the container writes into the bind-mounted workspace is
  // therefore root-owned on the host — the same trade the Dockerfile header
  // documents for `docker run`.
  "remoteUser": "root"
}
